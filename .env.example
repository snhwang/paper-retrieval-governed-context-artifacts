# Copy this file to `.env` in the repo root and fill in the values you need.
# The `.env` file is git-ignored; never commit real keys.
#
# Most paper tables are deterministic and need NO keys at all. Only the
# LLM-dependent steps below require credentials.

# Required to regenerate the LLM-inferred metadata (the ToolBench inferred-category
# conditions and the MetaTool generated tag sets). Default provider for
# metatool_generate_*.py and the *_categories.py evals.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if you pass an OpenAI model via --model to those scripts.
# Also used as a fallback by the metatool_generate_* scripts.
# OPENAI_API_KEY=sk-...

# Only needed if you generate metadata against a non-OpenAI, OpenAI-compatible
# host (e.g. Ollama) via the metatool_generate_* scripts.
# OLLAMA_API_KEY=...

# Hugging Face token, read by serve_mistral_nemo.sh. Not strictly required, but
# anonymous downloads of the ~24GB Mistral-Nemo weights are heavily rate-limited.
# Get one at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# serve_mistral_nemo.sh also reads these overrides from .env. Useful when the LLM
# server runs on a different machine than the evals, so vLLM's weights and KV
# cache never compete for VRAM with the evals' embedding models.
#   MODEL=mistralai/Mistral-Nemo-Instruct-2407
#   HOST=0.0.0.0          # bind all interfaces so a remote eval can reach it
#   PORT=8355
#   MAX_MODEL_LEN=32768   # the monolithic condition needs a large context window
#   GPU_MEM_UTIL=0.85     # raise when the GPU is dedicated to vLLM alone

# NOTE: The end-to-end evals (eval_toolbench_e2e.py and eval_toolbench_react.py)
# do NOT read a key from the environment. They talk to a local or remote
# OpenAI-compatible endpoint selected with --base-url / --model.
